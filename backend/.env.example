# Copy this file to .env in the backend/ folder and fill in real values.
# .env is already git-ignored (see backend/.gitignore).

PORT=5000

# MongoDB connection string. For local dev:
#   MONGO_URI=mongodb://127.0.0.1:27017/forma-ai
# For MongoDB Atlas, paste the connection string from your cluster.
MONGO_URI=mongodb://127.0.0.1:27017/forma-ai

# Used by services/mail.service.js (Gmail SMTP via nodemailer)
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# Used to build the email verification link and redirect after verification
CLIENT_URL=http://localhost:5173

# --- AI form generation (Google Gemini) ---
# Free API key: https://aistudio.google.com/apikey
# Leave blank to run entirely on the offline heuristic generator (no AI, but
# "Create with AI" still returns a usable form instead of erroring).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- Auth tokens ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
